# ==========================================================================
# Configuração do Seu Político
# Copie este arquivo para .env e preencha os valores.
# ==========================================================================

# Porta do servidor Express.
PORT=3000

# Use "true" para rodar com dados fictícios de demonstração
# (não requer chave da API nem banco de dados).
# Em PRODUÇÃO mantenha "false".
USE_MOCK=false

# Chave de acesso à API do Portal da Transparência do Governo Federal.
# Obtenha em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
CHAVE_API_PORTAL=

# Conexão com o PostgreSQL (opcional para testes, recomendado em produção).
# Crie o banco: docker compose up -d
# Depois aplique o esquema: npm run schema
DATABASE_URL=postgres://seupolitico:seupolitico@localhost:5432/seupolitico

# Limites de requisições por minuto (por segurança, abaixo do teto da API).
# Portal da Transparência: 400/min (dia) | 700/min (madrugada).
PORTAL_RPM=350

# Câmara dos Deputados: limite conservador.
CAMARA_RPM=120

# Período eleitoral (janela em que a aba "Candidatos" fica ativa).
# Ajuste para cada eleição. Formato: AAAA-MM-DD
ELEICAO_INICIO=2026-08-16
ELEICAO_FIM=2026-11-30
